{
  "name": "driving-simulation-telemetry-dashboard-application",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:ui\" \"npm run dev:electron\"",
    "electron:dev": "npm run dev",
    "dev:ui": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json -w & wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -b && vite build && npm run build:electron && electron-builder",
    "build:electron": "tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "ml-kmeans": "^7.0.0",
    "ml-pca": "^4.1.1",
    "ml-regression-multivariate-linear": "^2.0.4",
    "ml-svm": "^2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.driving.telemetry",
    "productName": "Driving Telemetry Dashboard",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.db*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/game-connectors/simulated-session.json",
        "to": "simulated-session.json"
      }
    ],
    "mac": {
      "category": "public.app-category.simulation"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
